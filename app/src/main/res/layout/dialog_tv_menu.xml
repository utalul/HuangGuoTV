<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_bg"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tvMenuTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/menu_title"
        android:textColor="@color/brand_yellow"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnToggleCursor"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_cursor_toggle"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnSwitchLine"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_switch_line"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnReloadConfig"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_reload_config"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnSwitchUa"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_switch_ua"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnClearCache"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_clear_cache"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnCheckUpdate"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_check_update"
        android:textColor="@color/white"
        android:textSize="15sp" />

    <Button
        android:id="@+id/btnCloseMenu"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/btn_selector"
        android:focusable="true"
        android:text="@string/menu_close"
        android:textColor="#B0BEC5"
        android:textSize="15sp" />

</LinearLayout>
