<?xml version="1.0" encoding="utf-8"?>
<com.huangguo.tv.view.CursorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cursorContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true">

    <!-- 核心 H5 播放視圖 -->
    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:focusable="true"
        android:focusableInTouchMode="true" />

    <!-- 網頁載入頂部微型進度條 -->
    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_gravity="top"
        android:progressDrawable="@drawable/progress_bar_horizontal"
        android:visibility="gone" />

    <!-- 虛擬滑鼠游標視圖 (由 CursorLayout 控制座標與顯示) -->
    <ImageView
        android:id="@+id/cursorView"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="Virtual Mouse Cursor"
        android:src="@drawable/cursor_pointer"
        android:visibility="gone" />

    <!-- 操作提示 HUD (短暫顯示模式切換) -->
    <TextView
        android:id="@+id/tvModeHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="24dp"
        android:background="@drawable/dialog_bg"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone" />

</com.huangguo.tv.view.CursorLayout>
