<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 遙控器焦點狀態 (高亮放大邊框) -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#40FFD600" />
            <stroke android:width="2dp" android:color="@color/brand_yellow" />
        </shape>
    </item>

    <!-- 被選中狀態 -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="@color/brand_yellow" />
            <stroke android:width="1dp" android:color="@color/brand_yellow" />
        </shape>
    </item>

    <!-- 預設狀態 (半透明圓角膠囊) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#22FFFFFF" />
            <stroke android:width="1dp" android:color="#15FFFFFF" />
        </shape>
    </item>
</selector>
